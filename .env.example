# =============================================
# SOVR ORACLE LEDGER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# =============================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ORACLE_LEDGER

# Stripe (Required for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Blockchain / Web3
ETHEREUM_RPC_URL=https://mainnet.base.org
CONSUL_CREDITS_CONTRACT=0x65e75d0fC656a2E81eF17E9A2A8Da58D82390422
PRIVATE_KEY=0xYourPrivateKeyForOracleOperations
BASESCAN_API_KEY=your_basescan_api_key

# Security
SESSION_SECRET=your_super_secure_session_secret_min_32_chars
JWT_SECRET=your_jwt_secret_min_32_chars
NODE_ENV=development

# Application
PORT=3001
GATEWAY_PORT=3002
RISK_COMPLIANCE_PORT=3003
PAYMENT_GATEWAY_PORT=3005

# Compliance & Logging
PCI_AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=2555
LOG_LEVEL=info

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100